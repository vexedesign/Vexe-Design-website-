# Copy this file to .env.local (local) or add these in your host's
# "Environment Variables" screen (Vercel / Netlify etc.). NEVER commit real keys.

# Your Resend API key (https://resend.com/api-keys). Server-side only.
RESEND_API_KEY=

# Where enquiries are delivered.
CONTACT_EMAIL=contact@vexedesign.com

# The "from" address. Must be on a domain you have verified in Resend,
# e.g. "Vexe Design <enquiries@vexedesign.com>".
# While testing you can use: "Vexe Design <onboarding@resend.dev>"
CONTACT_FROM_EMAIL=Vexe Design <onboarding@resend.dev>
